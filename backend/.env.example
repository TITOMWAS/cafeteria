PORT=5001
DATABASE_URL=postgresql://postgres:password@localhost:5433/cafeteria_db
JWT_SECRET=your_super_secret_jwt_key_here
NODE_ENV=development

# PayHero payment gateway (https://dashboard.payhero.co.ke -> Settings -> API)
PAYHERO_USERNAME=your_payhero_api_username
PAYHERO_PASSWORD=your_payhero_api_password
PAYHERO_CHANNEL_ID=123456
# Optional: where PayHero posts transaction callbacks
PAYHERO_CALLBACK_URL=
# Payment mode: 'sandbox' = simulated STK push (SBOX- refs, no real money).
# Omit or set 'live' to hit the real PayHero API once credentials are configured.
PAYHERO_MODE=sandbox

# ---- Cloudflare security ----
# Turnstile captcha (https://dash.cloudflare.com -> Turnstile). Leave blank in dev:
# verification is skipped entirely until both keys exist.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Extra allowed browser origins (comma-separated), e.g. https://cafeteria.your.ac.ke
CORS_ORIGINS=
# Express 'trust proxy' setting behind the Cloudflare proxy/tunnel.
TRUST_PROXY=loopback, linklocal, uniquelocal

# ---- Durable meal-image storage (Cloudflare R2 via media Worker) ----
# Optional in dev (falls back to local uploads/ dir). On hosts with an
# ephemeral disk (e.g. Render free tier) set both so images survive deploys:
#   R2_MEDIA_URL   = https://cafeteria-r2-media.<subdomain>.workers.dev
#   R2_MEDIA_SECRET= same value as the Worker's UPLOADER_SECRET
R2_MEDIA_URL=
R2_MEDIA_SECRET=
